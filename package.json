{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server/index.mjs",
    "dev:vite": "vite",
    "build": "vite build",
    "preview": "node server/index.mjs --prod",
    "typecheck": "tsc --noEmit",
    "data": "node scripts/build-data.mjs",
    "test:houses": "esbuild tests/houses.check.ts --bundle --platform=node --format=esm --outfile=.cache/houses.check.mjs --log-level=error && node .cache/houses.check.mjs",
    "test:ayanamsa": "esbuild tests/ayanamsa.check.ts --bundle --platform=node --format=esm --outfile=.cache/ayanamsa.check.mjs --log-level=error && node .cache/ayanamsa.check.mjs",
    "test": "npm run test:houses && npm run test:ayanamsa && npm run test:points",
    "test:points": "esbuild tests/points.check.ts --bundle --platform=node --format=esm --outfile=.cache/points.check.mjs --log-level=error && node .cache/points.check.mjs"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "clsx": "2.1.1",
    "framer-motion": "^13.2.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0",
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  }
}
