{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server/index.mjs",
    "dev:vite": "vite",
    "build": "vite build",
    "preview": "node server/index.mjs --prod",
    "typecheck": "tsc --noEmit",
    "data": "node scripts/build-data.mjs",
    "test": "npm run test:sky && npm run test:sky3d && npm run test:ui3d && npm run test:wheel && npm run test:health-ui && npm run test:example && npm run test:ai",
    "test:example": "esbuild tests/example.check.ts --bundle --platform=node --format=esm --outfile=.cache/example.check.mjs --log-level=error && node .cache/example.check.mjs",
    "test:sky": "esbuild tests/sky.check.ts --bundle --platform=node --format=esm --external:@napi-rs/canvas --external:react --external:react-dom --outfile=.cache/sky.check.mjs --log-level=error && node .cache/sky.check.mjs",
    "test:sky3d": "esbuild tests/sky3d.check.ts --bundle --platform=node --format=esm --external:@napi-rs/canvas --outfile=.cache/sky3d.check.mjs --log-level=error && node .cache/sky3d.check.mjs",
    "shot:wheel": "esbuild scripts/wheel-shot.ts --bundle --platform=node --format=esm --external:@napi-rs/canvas --external:react --external:react-dom --outfile=.cache/wheel-shot.mjs --alias:@=./src --log-level=error && node .cache/wheel-shot.mjs",
    "shot:sky3d": "esbuild scripts/sky3d-shot.ts --bundle --platform=node --format=esm --external:@napi-rs/canvas --outfile=.cache/sky3d-shot.mjs --alias:@=./src --log-level=error && node .cache/sky3d-shot.mjs",
    "test:ui3d": "esbuild tests/ui3d-smoke-entry.tsx --bundle --platform=browser --format=iife --jsx=automatic --loader:.css=empty --define:process.env.NODE_ENV='\"development\"' --outfile=.cache/ui3d-smoke.js --alias:@=./src --log-level=error && node tests/ui3d-smoke.mjs",
    "check:ai": "node scripts/check-ai.mjs",
    "test:ai": "esbuild tests/ai-api.check.ts --bundle --platform=node --format=esm --outfile=.cache/ai-api.check.mjs --log-level=error && node .cache/ai-api.check.mjs",
    "test:health-ui": "esbuild tests/health-ui.check.ts --bundle --platform=node --format=esm --external:react --external:react-dom --outfile=.cache/health-ui.check.mjs --alias:@=./src --log-level=error && node .cache/health-ui.check.mjs",
    "test:wheel": "esbuild tests/wheel.check.ts --bundle --platform=node --format=esm --external:react --external:react-dom --outfile=.cache/wheel.check.mjs --log-level=error && node .cache/wheel.check.mjs"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "clsx": "2.1.1",
    "framer-motion": "^13.2.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0",
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "esbuild": "0.28.2",
    "jsdom": "^30.0.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-plugin-singlefile": "2.3.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
