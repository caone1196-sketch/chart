# Sao chép tệp này thành .env rồi điền khoá thật (tệp .env đã bị .gitignore bỏ qua).
# Trên Vercel: Settings → Environment Variables → thêm cùng tên biến, chọn môi trường
# Production/Preview, sau đó DEPLOY LẠI thì function mới nhận được biến.

# ── Khoá Gemini (tạo miễn phí tại https://aistudio.google.com/apikey) ──────────────
# Khoá chính. Khoá chỉ nằm ở máy chủ, không bao giờ được gửi xuống trình duyệt.
GEMINI_API_KEY=

# ── Nhiều khoá: máy chủ tự xoay khi khoá lỗi / hết quota ───────────────────────────
# Cách 1 (gọn nhất): liệt kê trong GEMINI_API_KEYS, ngăn cách bằng dấu phẩy hoặc xuống dòng.
# Thứ tự quan trọng: app thử khoá đầu tiên trước, chỉ xoay khi khoá đó không dùng được.
# GEMINI_API_KEYS=

# Cách 2: khai từng biến, tối đa 9 khoá. GEMINI_API_KEY ở trên luôn được thử trước.
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=

# Khi nào app xoay khoá? Chỉ với lỗi THUỘC VỀ KHOÁ: khoá sai (GEMINI_BAD_KEY),
# khoá bị giới hạn referrer/IP (GEMINI_KEY_RESTRICTED), hết quota (GEMINI_QUOTA),
# model chưa mở cho project của khoá (GEMINI_MODEL_NOT_FOUND), Google lỗi 5xx.
# Lỗi thuộc về câu hỏi (bộ lọc an toàn, quá thời gian) thì không xoay khoá.

# ── Model ─────────────────────────────────────────────────────────────────────────
# Tuỳ chọn — mặc định gemini-3.6-flash (model duy nhất app sử dụng).
# Chỉ đặt biến này khi cần trỏ sang model khác.
# GEMINI_MODEL=gemini-3.6-flash

# Model dự phòng: mặc định KHÔNG có (app chỉ gọi đúng một model). Chỉ khai khi muốn có
# đường lui lúc model chính bị Google báo quá tải (5xx) hoặc chưa mở cho khoá (404).
# GEMINI_MODEL_FALLBACKS=gemini-3.5-flash,gemini-2.5-flash

# ── Tự thử lại khi Google chập chờn (5xx / rớt mạng) ───────────────────────────────
# "Máy chủ Google tạm thời lỗi (GEMINI_UPSTREAM)" thường là 503 "The model is overloaded":
# lỗi của máy chủ Google, KHÔNG phải lỗi khoá API — chờ vài giây rồi gọi lại thường là được.
# Máy chủ tự thử lại tối đa GEMINI_MAX_ATTEMPTS lần cho MỖI (khoá, model), chờ tăng dần từ
# GEMINI_RETRY_BASE_MS (gấp đôi mỗi lần, trần GEMINI_RETRY_MAX_MS, có jitter), tôn trọng
# Retry-After / RetryInfo.retryDelay của Google, và luôn dừng trước GEMINI_BUDGET_MS để kịp
# maxDuration 60 giây của Vercel Function. Hết lượt mới xoay khoá, rồi mới đổi model dự phòng.
# GEMINI_MAX_ATTEMPTS=3        # đặt 1 nếu muốn tắt tự thử lại (hành vi cũ: lỗi một lần là bỏ)
# GEMINI_RETRY_BASE_MS=800
# GEMINI_RETRY_MAX_MS=6000
# GEMINI_BUDGET_MS=45000       # phải < 60000 (maxDuration của function)
# GEMINI_QUOTA_WAIT_MS=10000   # chỉ "ngồi chờ" 429 khi Google báo chờ ngắn hơn mức này
                               # và đã hết khoá để xoay; đặt 0 nếu không bao giờ muốn chờ

# ── Máy chủ dev/preview ───────────────────────────────────────────────────────────
# PORT=5173

# Kiểm tra sau khi điền: `npm run check:ai` (in trạng thái từng khoá),
# hoặc mở /api/health (thêm ?probe=1 để gọi thử Google với từng khoá).
# Muốn biết "lỗi này do khoá hay do Google?": `npm run check:ai -- --ask`
# (gọi thật generateContent như trình duyệt, in số lần tự thử lại và kết luận).
